{
  "name": "everystate",
  "version": "0.2.0",
  "description": "A TLA+ model checker with no Java dependency (TLC-compatible). Rust engine compiled to WebAssembly.",
  "type": "module",
  "license": "MIT",
  "main": "wasm/everystate.mjs",
  "types": "wasm/everystate.d.ts",
  "exports": { ".": { "types": "./wasm/everystate.d.ts", "default": "./wasm/everystate.mjs" } },
  "bin": { "everystate": "wasm/cli.mjs" },
  "files": ["wasm/everystate.mjs", "wasm/everystate.d.ts", "wasm/everystate.wasm", "wasm/cli.mjs", "README.md", "LICENSE"],
  "scripts": {
    "build": "cargo build --release && sh wasm/build.sh",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts && node test/community.mjs",
    "conformance:examples": "node scripts/conformance.mjs",
    "conformance:tlc": "node scripts/diff-tlc.mjs",
    "conformance:statechart": "node scripts/statechart-corpus.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "engines": { "node": ">=20" },
  "keywords": ["tla", "tlaplus", "tlc", "model-checker", "formal-verification", "wasm"],
  "repository": { "type": "git", "url": "git+https://github.com/mattzcarey/everystate.git" }
}
