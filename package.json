{
  "name": "everystate",
  "version": "0.1.0",
  "description": "A TLA+ model checker (TLC-compatible) written in pure TypeScript. No Java.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "everystate": "dist/cli.js",
    "everystate-java": "dist/java.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONFORMANCE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "bundle": "node scripts/bundle.mjs",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "conformance:examples": "node scripts/conformance.mjs",
    "conformance:tlc": "node scripts/diff-tlc.mjs",
    "conformance:statechart": "node scripts/statechart-corpus.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "tla+",
    "tlaplus",
    "tlc",
    "model-checker",
    "formal-verification",
    "formal-methods"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattzcarey/verify.js.git"
  }
}
