{
  "name": "verify.js",
  "version": "0.1.0",
  "description": "A TLA+ model checker (TLC-compatible) written in pure TypeScript. No Java.",
  "type": "module",
  "license": "MIT",
  "bin": { "verify": "dist/cli.js", "tlc": "dist/cli.js" },
